# Cashfree Payment Gateway Configuration
# -------------------------------------------------------------------
# LOCAL DEVELOPMENT (localhost):
#   - Set CASHFREE_ENV=sandbox below
#   - Get SANDBOX/TEST mode keys from Cashfree Merchant Dashboard →
#     https://merchant.cashfree.com/ → Choose "Test Mode" → Developers → API Keys
#   - Sandbox allows http://localhost URLs (no HTTPS required)
#
# PRODUCTION DEPLOYMENT (public HTTPS domain):
#   - Set CASHFREE_ENV=production
#   - Use LIVE/PRODUCTION mode keys from Cashfree dashboard
#   - FRONTEND_URL and BACKEND_URL MUST be https:// URLs
# -------------------------------------------------------------------
CASHFREE_ENV=sandbox

# SANDBOX keys (obtain from Cashfree Dashboard → Test Mode → API Keys):
CASHFREE_APP_ID=TEST10734652ffb45c76a6445ad4df5325643701
CASHFREE_SECRET_KEY=
# CASHFREE_SECRET_KEY=cfsk_ma_prod_134f4bc1c623769aa2f80301b6e97095_e0cbd1cc

# Firebase Admin SDK (Server-side auth — for verifying Firebase ID tokens)
# -------------------------------------------------------------------
# Setup:
#   1. Open Firebase Console → https://console.firebase.google.com → your project
#   2. Project settings (gear icon) → Service accounts tab → Firebase Admin SDK
#   3. Click "Generate new private key" → download the JSON file
#   4. Paste values:
#        JSON project_id   → FIREBASE_PROJECT_ID
#        JSON client_email → FIREBASE_CLIENT_EMAIL
#        JSON private_key  → FIREBASE_PRIVATE_KEY  (entire multi-line string, keep \n as \n)
#
# Leave empty to disable Firebase auth and use legacy email+password only.
# -------------------------------------------------------------------
